<Page x:Class="UP_Bykov_Payment.Pages.AddCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UP_Bykov_Payment.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление категории">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Название категории" Grid.Row="0" FontSize="20" VerticalAlignment="Center"/>
        <TextBox x:Name="TBCategoryName" Grid.Row="0" Grid.Column="1" MaxLength="100"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Например: Коммунальные услуги"/>

        <Button x:Name="ButtonClean" Content="Очистить" Grid.Row="1" Grid.ColumnSpan="2"
                HorizontalAlignment="Left" ToolTip="Очистить поле" Click="ButtonClean_Click"/>
        <Button x:Name="ButtonSaveCategory" Content="Сохранить" Grid.Row="1" Grid.ColumnSpan="2"
                HorizontalAlignment="Right" ToolTip="Сохранить данные" Click="ButtonSaveCategory_Click"/>
    </Grid>
</Page>
