<Page x:Class="UP_Bykov_Payment.Pages.AddPaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UP_Bykov_Payment.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление платежа">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Название платежа" Grid.Row="0" FontSize="20" VerticalAlignment="Center"/>
        <TextBlock Text="Цена, руб." Grid.Row="1" FontSize="20" VerticalAlignment="Center"/>
        <TextBlock Text="Количество" Grid.Row="2" FontSize="20" VerticalAlignment="Center"/>
        <TextBlock Text="Дата" Grid.Row="3" FontSize="20" VerticalAlignment="Center"/>
        <TextBlock Text="Пользователь" Grid.Row="4" FontSize="20" VerticalAlignment="Center"/>
        <TextBlock Text="Категория" Grid.Row="5" FontSize="20" VerticalAlignment="Center"/>

        <TextBox x:Name="TBPaymentName" Grid.Row="0" Grid.Column="1" MaxLength="100"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Например: Оплата за свет"/>

        <TextBox x:Name="TBAmount" Grid.Row="1" Grid.Column="1" MaxLength="10"
                 ToolTip="Цена за единицу: от 0,01 до 1 000 000 руб. Дробную часть отделяйте запятой"
                 PreviewTextInput="TBAmount_PreviewTextInput"/>

        <TextBox x:Name="TBCount" Grid.Row="2" Grid.Column="1" MaxLength="4"
                 ToolTip="Количество: целое число от 1 до 1000"
                 PreviewTextInput="TBCount_PreviewTextInput"/>

        <DatePicker x:Name="DPDate" Grid.Row="3" Grid.Column="1" Height="30" FontSize="14"
                    SelectedDate="{Binding Date}"
                    ToolTip="Дата платежа (не позже сегодняшнего дня)">
            <DatePicker.Resources>
                <!-- чтобы общий стиль кнопок не растягивал кнопку календаря -->
                <Style TargetType="Button"/>
            </DatePicker.Resources>
        </DatePicker>

        <ComboBox x:Name="CBUser" Grid.Row="4" Grid.Column="1"
                  SelectedValuePath="ID" SelectedValue="{Binding UserID}"
                  ToolTip="Выберите пользователя"/>

        <ComboBox x:Name="CBCategory" Grid.Row="5" Grid.Column="1"
                  SelectedValuePath="ID" SelectedValue="{Binding CategoryID}"
                  ToolTip="Выберите категорию"/>

        <Button x:Name="ButtonClean" Content="Очистить" Grid.Row="6" Grid.ColumnSpan="2"
                HorizontalAlignment="Left" ToolTip="Очистить поля" Click="ButtonClean_Click"/>
        <Button x:Name="ButtonSave" Content="Сохранить" Grid.Row="6" Grid.ColumnSpan="2"
                HorizontalAlignment="Right" ToolTip="Сохранить данные" Click="ButtonSave_Click"/>
    </Grid>
</Page>
