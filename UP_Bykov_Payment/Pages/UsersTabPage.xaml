<Page x:Class="UP_Bykov_Payment.Pages.UsersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UP_Bykov_Payment.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Таблица пользователей">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="377*"/>
            <RowDefinition Height="73*"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" x:Name="DataGridUser" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="100"/>
                <DataGridTextColumn Header="Пароль (хэш)" Binding="{Binding Password}" Width="150"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="70"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="220"/>
                <DataGridTextColumn Header="Фото" Binding="{Binding Photo}" Width="100"/>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" x:Name="ButtonAdd" Content="Добавить" HorizontalAlignment="Left" Margin="20,0,0,0"
                ToolTip="Добавить данные" Click="ButtonAdd_Click"/>
        <Button Grid.Row="1" x:Name="ButtonDel" Content="Удалить" HorizontalAlignment="Right" Margin="0,0,20,0"
                ToolTip="Удалить выделенные строки (можно выделить несколько через Ctrl)" Click="ButtonDel_Click"/>
    </Grid>
</Page>
