<Page x:Class="UP_Bykov_Payment.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UP_Bykov_Payment.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление пользователя">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Логин" Grid.Row="0" VerticalAlignment="Center" FontSize="20"/>
        <TextBlock Text="Пароль" Grid.Row="1" VerticalAlignment="Center" FontSize="20"/>
        <TextBlock Text="Роль" Grid.Row="2" VerticalAlignment="Center" FontSize="20"/>
        <TextBlock Text="ФИО" Grid.Row="3" VerticalAlignment="Center" FontSize="20"/>
        <TextBlock Text="Фото (необязательно)" Grid.Row="4" VerticalAlignment="Center" FontSize="20"/>

        <TextBox x:Name="TBLogin" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" MaxLength="50"
                 ToolTip="Логин: латинские буквы, цифры, символы @ . _"
                 PreviewTextInput="TBLogin_PreviewTextInput"/>
        <TextBox x:Name="TBPass" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" MaxLength="100"
                 ToolTip="Не менее 6 символов, только английские буквы и цифры, хотя бы одна цифра. При редактировании можно не менять"/>
        <ComboBox x:Name="cmbRole" SelectedItem="{Binding Role}" Grid.Row="2" Grid.Column="1"
                  ToolTip="Выберите роль"/>
        <TextBox x:Name="TBFio" Text="{Binding FIO, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" MaxLength="150"
                 ToolTip="Фамилия Имя Отчество, только буквы"
                 PreviewTextInput="TBFio_PreviewTextInput"/>
        <TextBox x:Name="TBPhoto" Text="{Binding Photo, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1"
                 ToolTip="Путь к файлу с фотографией" IsReadOnly="True"/>
        <Button x:Name="ButtonPhoto" Content="Выбрать фото" Grid.Row="4" Grid.Column="2"
                ToolTip="Выбрать файл с фотографией" Click="ButtonPhoto_Click"/>

        <Button x:Name="ButtonSave" Content="Сохранить" Grid.Row="5" Grid.ColumnSpan="2"
                HorizontalAlignment="Right" ToolTip="Сохранить данные" Click="ButtonSave_Click"/>
        <Button x:Name="ButtonClean" Content="Очистить" Grid.Row="5" Grid.ColumnSpan="2"
                HorizontalAlignment="Left" ToolTip="Очистить поля" Click="ButtonClean_Click"/>
    </Grid>
</Page>
