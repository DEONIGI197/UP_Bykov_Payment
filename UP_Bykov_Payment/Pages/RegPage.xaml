<Page x:Class="UP_Bykov_Payment.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UP_Bykov_Payment.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Регистрация нового пользователя" Grid.ColumnSpan="2"
                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource PanelBackground}"/>

        <!-- подписи -->
        <Label Content="Введите логин" Grid.Row="1" VerticalAlignment="Center"/>
        <Label Content="Введите пароль" Grid.Row="2" VerticalAlignment="Center"/>
        <Label Content="Подтвердите пароль" Grid.Row="3" VerticalAlignment="Center"/>
        <Label Content="Выберите роль" Grid.Row="4" VerticalAlignment="Center"/>
        <Label Content="Введите ФИО" Grid.Row="5" VerticalAlignment="Center"/>

        <!-- логин -->
        <TextBox x:Name="txtbxLog" Grid.Column="1" Grid.Row="1" MaxLength="50"
                 ToolTip="Логин: латинские буквы, цифры, символы @ . _"
                 PreviewTextInput="txtbxLog_PreviewTextInput"
                 TextChanged="txtbxLog_TextChanged"/>
        <Label x:Name="lblLogHitn" ToolTip="{Binding ToolTip, ElementName=txtbxLog}" Content="Введите логин" Grid.Column="1" Grid.Row="1"
               Foreground="Gray" VerticalAlignment="Center"
               MouseLeftButtonUp="lblLogHitn_MouseLeftButtonUp"/>

        <!-- пароль -->
        <PasswordBox x:Name="passBxFrst" Grid.Column="1" Grid.Row="2" MaxLength="50"
                     ToolTip="Не менее 6 символов, только английские буквы и цифры, хотя бы одна цифра"
                     PasswordChanged="passBxFrst_PasswordChanged"/>
        <Label x:Name="lblPassHitn" ToolTip="{Binding ToolTip, ElementName=passBxFrst}" Content="Введите пароль" Grid.Column="1" Grid.Row="2"
               Foreground="Gray" VerticalAlignment="Center"
               MouseLeftButtonUp="lblPassHitn_MouseLeftButtonUp"/>

        <!-- подтверждение пароля -->
        <PasswordBox x:Name="passBxScnd" Grid.Column="1" Grid.Row="3" MaxLength="50"
                     ToolTip="Повторите пароль"
                     PasswordChanged="passBxScnd_PasswordChanged"/>
        <Label x:Name="lblPassSecHitn" ToolTip="{Binding ToolTip, ElementName=passBxScnd}" Content="Повторите пароль" Grid.Column="1" Grid.Row="3"
               Foreground="Gray" VerticalAlignment="Center"
               MouseLeftButtonUp="lblPassSecHitn_MouseLeftButtonUp"/>

        <!-- роль -->
        <ComboBox x:Name="comboBxRole" Grid.Column="1" Grid.Row="4"
                  ToolTip="Выберите роль: User - пользователь, Admin - администратор">
            <ComboBoxItem Content="User"/>
            <ComboBoxItem Content="Admin"/>
        </ComboBox>

        <!-- ФИО -->
        <TextBox x:Name="txtbxFIO" Grid.Column="1" Grid.Row="5" MaxLength="150"
                 ToolTip="Фамилия Имя Отчество, только буквы"
                 PreviewTextInput="txtbxFIO_PreviewTextInput"
                 TextChanged="txtbxFIO_TextChanged"/>
        <Label x:Name="lblFioHitn" ToolTip="{Binding ToolTip, ElementName=txtbxFIO}" Content="Введите ФИО" Grid.Column="1" Grid.Row="5"
               Foreground="Gray" VerticalAlignment="Center"
               MouseLeftButtonUp="lblFioHitn_MouseLeftButtonUp"/>

        <Button x:Name="regButton" Content="Зарегистрироваться" Grid.Row="6" Grid.ColumnSpan="2"
                ToolTip="Зарегистрировать нового пользователя" Click="regButton_Click"/>
    </Grid>
</Page>
