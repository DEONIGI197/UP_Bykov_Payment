<Page x:Class="UP_Bykov_Payment.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UP_Bykov_Payment.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница администратора">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Панель администратора" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       Foreground="{DynamicResource PanelBackground}"/>

            <Button x:Name="BtnTab1" Content="Таблица пользователей"
                    ToolTip="Добавление, редактирование и удаление пользователей"
                    Click="BtnTab1_Click"/>
            <Button x:Name="BtnTab2" Content="Таблица категорий"
                    ToolTip="Добавление, редактирование и удаление категорий"
                    Click="BtnTab2_Click"/>
            <Button x:Name="BtnTab3" Content="Таблица платежей"
                    ToolTip="Добавление, редактирование и удаление платежей"
                    Click="BtnTab3_Click"/>
            <Button x:Name="BtnTab4" Content="Диаграммы"
                    ToolTip="Диаграмма платежей и выгрузка отчетов"
                    Click="BtnTab4_Click"/>
            <Button x:Name="BtnUsers" Content="Просмотр пользователей"
                    ToolTip="Просмотр, поиск, сортировка и фильтрация пользователей"
                    Click="BtnUsers_Click"/>
        </StackPanel>
    </Grid>
</Page>
