<Page x:Class="UP_Bykov_Payment.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UP_Bykov_Payment.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

            <TextBlock Text="Смена пароля" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,15"
                       Foreground="{DynamicResource PanelBackground}"/>

            <Label Content="Логин"/>
            <Grid>
                <TextBox x:Name="TbLogin" MaxLength="50" ToolTip="Введите свой логин"
                         TextChanged="TbLogin_TextChanged"/>
                <TextBlock x:Name="txtHintLogin" Text="Введите логин" Foreground="Gray"
                           Margin="6,0,0,0" VerticalAlignment="Center"
                           MouseLeftButtonUp="txtHintLogin_MouseLeftButtonUp"/>
            </Grid>

            <Label Content="Текущий пароль"/>
            <Grid>
                <PasswordBox x:Name="CurrentPasswordBox" MaxLength="50" ToolTip="Введите пароль, который используете сейчас"
                             PasswordChanged="CurrentPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="txtHintCurrent" Text="Текущий пароль" Foreground="Gray"
                           Margin="6,0,0,0" VerticalAlignment="Center"
                           MouseLeftButtonUp="txtHintCurrent_MouseLeftButtonUp"/>
            </Grid>

            <Label Content="Новый пароль"/>
            <Grid>
                <PasswordBox x:Name="NewPasswordBox" MaxLength="50"
                             ToolTip="Не менее 6 символов, только английские буквы и цифры, хотя бы одна цифра"
                             PasswordChanged="NewPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="txtHintNew" Text="Новый пароль" Foreground="Gray"
                           Margin="6,0,0,0" VerticalAlignment="Center"
                           MouseLeftButtonUp="txtHintNew_MouseLeftButtonUp"/>
            </Grid>

            <Label Content="Подтверждение пароля"/>
            <Grid>
                <PasswordBox x:Name="ConfirmPasswordBox" MaxLength="50" ToolTip="Повторите новый пароль"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="txtHintConfirm" Text="Повторите новый пароль" Foreground="Gray"
                           Margin="6,0,0,0" VerticalAlignment="Center"
                           MouseLeftButtonUp="txtHintConfirm_MouseLeftButtonUp"/>
            </Grid>

            <Button x:Name="ButtonSave" Content="Сохранить" Margin="0,20,0,0"
                    ToolTip="Сохранить новый пароль" Click="ButtonSave_Click"/>
        </StackPanel>
    </Grid>
</Page>
